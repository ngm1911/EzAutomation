<Window x:Class="AutomationTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:views="clr-namespace:AutomationTool.Views" xmlns:vm="clr-namespace:AutomationTool.ViewModel" mc:Ignorable="d" Title="{Binding Title}" Height="550" Width="800">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <DockPanel LastChildFill="True">
        <views:ToolbarView DockPanel.Dock="Top"/>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <views:LeftSideBarView x:Name="LeftSideBar" Grid.Column="0" BorderThickness="0"/>
            
            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Gray" ShowsPreview="True"/>
            
            <views:MainContentView x:Name="MainContent" Grid.Column="2"/>
        </Grid>
    </DockPanel>
</Window>
